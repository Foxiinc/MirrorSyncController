{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Information"
    }
  },
  "AllowedHosts": "*",
  "MirrorSync": {
    "GrpcPort": 50051,
    "AgentPort": 4444,
    "MaxDevices": 20,
    "ScanIntervalMs": 5000,
    "CommandTimeoutMs": 5000,
    "SyncDelayMs": 50,
    "MaxReconnectAttempts": 5,
    "AdbPaths": [
      "C:\\platform-tools\\adb.exe",
      "C:\\Android\\Sdk\\platform-tools\\adb.exe",
      "%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe"
    ]
  }
}
